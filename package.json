{
  "name": "agentic-diplo-track-sys",
  "type": "module",
  "version": "0.1.0",
  "description": "",
  "license": "ISC",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bun cli/doctor.ts --preflight && bun cli/install.ts",
    "setup:doctor": "bun cli/doctor.ts",
    "agents:setup": "bun scripts/agents-setup.ts",
    "up": "bun cli/update-boilerplate.ts",
    "onboarding": "bun scripts/onboarding.ts",
    "api:sync": "bun scripts/sync-openapi.ts",
    "vars:check": "bun scripts/lint-vars.ts",
    "skills:check": "bun scripts/lint-skills.ts",
    "skills:registry": "bun scripts/build-skill-registry.ts",
    "skills:registry:check": "bun scripts/build-skill-registry.ts --check",
    "jira:sync-fields": "bun scripts/sync-jira-fields.ts",
    "jira:sync-workflows": "bun scripts/sync-jira-workflows.ts",
    "jira:sync-issues": "bun scripts/sync-jira-issues.ts",
    "jira:check": "bun scripts/check-jira-setup.ts",
    "format:fix": "prettier --write '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "format:check": "prettier --check '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "types:check": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:kata": "bun test tests/kata",
    "test:e2e": "playwright test",
    "test:smoke:production": "ALLURE_DIR=allure-results-prod playwright test tests/e2e/production-smoke.test.ts",
    "test:a11y": "playwright test tests/e2e/a11y-smoke.test.ts",
    "traceability:generate": "bun scripts/generate-traceability.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "repo:check": "bun run format:check && bun run lint:check && bun run types:check && bun run test && bun run vars:check && bun run vars:env:check && bun run skills:check && bun run skills:registry:check",
    "repo:fix": "bun run format:fix && bun run lint:fix && bun run types:check && bun run test && bun run vars:check && bun run vars:env:check && bun run skills:check && bun run skills:registry:check",
    "clean": "rm -rf node_modules dist",
    "prepare": "husky",
    "claude": "bash -c 'set -a; . ./.env; set +a; exec claude \"$@\"' --",
    "opencode": "bash -c 'set -a; . ./.env; set +a; exec opencode \"$@\"' --",
    "env": "set -a; source .env; set +a",
    "jira:sync-link-types": "bun scripts/sync-jira-link-types.ts",
    "vars:env:check": "bun scripts/check-vars.ts",
    "graph:rebuild": "graphify update .",
    "graph:rebuild:semantic": "graphify extract . --backend gemini --model gemini-2.5-flash-preview"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@inquirer/prompts": "^8.1.0",
    "boxen": "^8.0.1",
    "cli-table3": "^0.6.5",
    "figures": "^6.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.2.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,yml,yaml,css,scss,html}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  }
}
