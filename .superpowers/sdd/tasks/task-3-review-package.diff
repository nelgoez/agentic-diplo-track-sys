+++ b/.github/workflows/planning-ci.yml
@@ -71,3 +71,23 @@ jobs:
         with:
           name: traceability-matrix
           path: traceability-out/
+
+  a11y-check:
+    name: a11y check
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    needs: [planning-check]
+    if: always()
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+      - name: Setup Bun
+        uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: latest
+      - name: Install dependencies
+        run: bun install
+      - name: Run a11y tests
+        run: bun run test:a11y
+        env:
+          BASE_URL: ${{ vars.BASE_URL || 'http://localhost:3000' }}
