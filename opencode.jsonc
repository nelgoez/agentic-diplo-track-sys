{
  // OpenCode shared team config — committed to git.
  // Secrets are NEVER stored here: every {env:VAR} placeholder is resolved
  // from the developer's local environment (loaded from .env via `bun run opencode`,
  // direnv, or a manually-sourced shell). See .env.example for required vars.
  //
  // Syntax notes (OpenCode-specific, different from Claude Code's .mcp.json):
  //   - Env var expansion uses {env:VAR_NAME}  (NOT ${VAR})
  //   - MCP root key is "mcp"                  (NOT "mcpServers")
  //   - MCP env field is "environment"         (NOT "env")
  //   - Missing env vars resolve to empty string (no hard failure) — see CLAUDE.md
  //     Critical Reminder about stopping immediately when MCP credentials fail.
  "$schema": "https://opencode.ai/config.json",

  // Instructions — files pre-loaded as system context every session.
  // Token-saving: eliminates repeated Read-tool calls for these docs.
  // Dynamic @file resolution handled by /.opencode/plugins/at-resolver.ts
  // and /.opencode/commands/resume.md (OpenCode natively resolves @file in commands).
  "instructions": [
    ".context/master-implementation-plan.md",
    ".context/business/business-data-map.md",
    ".context/PBI/README.md",
    ".opencode/instructions/graphify-context.md",
  ],

  // Plugins:
  //   - `@warp-dot-dev/opencode-warp`: Warp terminal integration — surfaces
  //     OpenCode agent activity as native Warp notifications. Auto-installed
  //     when OpenCode runs inside Warp.
  //     Docs: https://docs.warp.dev/agent-platform/cli-agents/opencode/
  //   - `opencode-subagent-statusline`: renders an active-subagent statusline
  //     in the OpenCode TUI so multi-agent dispatch is visible at a glance.
  "plugin": ["@warp-dot-dev/opencode-warp", "opencode-subagent-statusline"],

  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bunx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
    },
    "tavily": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "mcp-remote",
        "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      ],
      "enabled": true,
    },
    "supabase": {
      "type": "local",
      "command": ["bunx", "-y", "@supabase/mcp-server-supabase@latest"],
      "enabled": true,
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}",
      },
    },
    "n8n": {
      "type": "local",
      "command": ["npx", "-y", "n8n-mcp"],
      "enabled": true,
      "environment": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "{env:N8N_API_URL}",
        "N8N_API_KEY": "{env:N8N_API_KEY}",
      },
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{env:ATLASSIAN_URL}",
        "JIRA_USERNAME": "{env:ATLASSIAN_EMAIL}",
        "JIRA_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}",
      },
    },
  },

  // Permissions — mirrors .claude/settings.json 1:1.
  // Rule precedence: last matching pattern wins, so deny entries are placed
  // AFTER the broad allows they override (e.g. `git *` allow, then
  // `git push --force *` deny — the deny wins for force-pushes).
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",

      "bun *": "allow",
      "bunx *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "node *": "allow",

      "git *": "allow",
      "gh *": "allow",

      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "tree *": "allow",
      "test *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "curl *": "allow",

      "acli *": "allow",
      "resend *": "allow",
      "supabase *": "allow",

      "rm -rf *": "deny",
      "sudo rm *": "deny",
      "sudo *": "deny",
      "wget *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git branch -D *": "deny",
      "chmod 777 *": "deny",
      "truncate *": "deny",
      "shred *": "deny",
      "dd if=*": "deny",
      "mkfs*": "deny",
    },
  },

  // Custom commands — also defined as .opencode/commands/*.md for portability.
  // @file references inside templates ARE resolved natively by OpenCode.
  "command": {
    "resume": {
      "description": "Resume last session from PBI module context — auto-loads SESSION-PROMPT.md, ROADMAP.md, and PROGRESS.md via @file resolution",
      "template": "You are resuming a previously interrupted session for the module $ARGUMENTS.\n\nStep 1: Load the current state by reading these files in order:\n\n@.context/PBI/$ARGUMENTS/SESSION-PROMPT.md\n\nIf SESSION-PROMPT.md does not exist, read instead:\n@.context/PBI/$ARGUMENTS/ROADMAP.md\n@.context/PBI/$ARGUMENTS/PROGRESS.md\n\nStep 2: After loading the context, tell me:\n- What module we are working on\n- Which story/phase was active\n- What the next action is (which ticket to implement)\n- Any blockers or open decisions from the last session\n\nStep 3: If the next ticket is clear, offer to run /sprint-development {TICKET-ID} to continue implementation.\n\nStep 4: If no module context exists, read @.context/master-implementation-plan.md and suggest the next sprint to start based on the roadmap.\n\nSkip missing files gracefully — do not error.",
      "agent": "plan",
    },
    "session": {
      "description": "Quick-load a specific context file — pass a path relative to project root (e.g., '.context/PBI/user-management/ROADMAP.md')",
      "template": "Read the file at @$ARGUMENTS and summarize its key points.\nIf it is a session-resume or progress file, tell me what work is in-flight and what the next action should be.\nIf it is a spec or plan file, tell me the main sections and what is actionable now.",
      "agent": "plan",
    },
  },
}
