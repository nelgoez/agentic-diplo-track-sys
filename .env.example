# ============================================================================
# Diploma Tracking System (DTS) — Environment Variables Template
# ============================================================================
#
# Quick Start:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values (see comments below)
# 3. Never commit .env to git (it's in .gitignore)
#
# Two ways to load these vars before launching the agent:
#   A) Cross-platform wrapper (default):
#        bun run opencode  → loads .env via dotenv-cli
#   B) Set as system/user env vars in your OS.
# ============================================================================

# ----------------------------------------------------------------------------
# MCP Server Environment Variables
# ----------------------------------------------------------------------------

# Tavily (web search MCP) — https://app.tavily.com/
TAVILY_API_KEY=

# Atlassian / Jira credentials (for acli + scripts)
# Get a token at: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_URL=https://diplo-track-sys.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Supabase project credentials (for app code, NOT MCP — MCP uses OAuth)
# Find these in your Supabase dashboard at Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n workflow automation (optional)
# Your n8n instance API URL + key
N8N_API_URL=
N8N_API_KEY=

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# - Supabase MCP (v0.8.1+) uses HTTP+OAuth — no access token needed.
#   Authenticate via browser on first MCP interaction.
# - Variables are loaded at agent start (dotenv-cli). MCP servers launched
#   from agent inherit the process environment.
# - Keep this .env.example file updated when adding new variables.
# ============================================================================
