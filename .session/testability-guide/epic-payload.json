      {
        "type": "blockquote",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "DBHub footgun: a missing "
              },
              {
                "type": "text",
                "text": "${VAR}",
                "marks": [
                  {
                    "type": "code"
                  }
                ]
              },
              {
                "type": "text",
                "text": " substitutes literally → cryptic auth failure. Verify: "
              },
              {
                "type": "text",
                "text": "env | grep DBHUB",
                "marks": [
                  {
                    "type": "code"
                  }
                ]
              },
              {
                "type": "text",
                "text": ".\nSession Pooler port 5432 (not 6543 — no prepared statements on transaction pooler)."
              }
            ]
          }
        ]
