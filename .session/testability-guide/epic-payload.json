            "type": "text",
            "text": " — BYPASSRLS, SELECT-only on public.\\"
          },
          {
            "type": "text",
            "text": "*"
          },
          {
            "type": "text",
            "text": ". Password column "
          },
          {
            "type": "text",
            "text": "users.password_hash",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": " is revoked at column level."
          }
