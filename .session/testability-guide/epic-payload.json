        "type": "codeBlock",
        "attrs": {},
        "content": [
          {
            "type": "text",
            "text": "POST /api/v1/auth/refresh\nBody: { \"refresh_token\": \"<token>\" }"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Token expires: access"
          },
          {
            "type": "text",
            "text": "_"
          },
          {
            "type": "text",
            "text": "token = 24h (configurable via "
          },
          {
            "type": "text",
            "text": "JWT_EXPIRES_IN",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": "), refresh"
          },
          {
            "type": "text",
            "text": "_"
          },
          {
            "type": "text",
            "text": "token = 7d."
          }
        ]
